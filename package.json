{
  "name": "BozKhar",
  "version": "0.8.0",
  "description": "Advise-only Chrome and Firefox extension that finds the cheapest way to buy a basket on digikala.com (see SDD/).",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:firefox": "vite build && node scripts/build-firefox.mjs",
    "audit:dist": "node scripts/audit-dist.mjs",
    "audit:dist:firefox": "node scripts/audit-firefox-dist.mjs",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^3.2.7",
    "web-ext": "^10.8.0"
  }
}
