{
  "name": "BozKhar",
  "version": "0.6.1",
  "description": "Advise-only browser extension that finds the cheapest way to buy a basket on digikala.com (see SDD/).",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "audit:dist": "node scripts/audit-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.2",
    "globals": "^16.5.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
